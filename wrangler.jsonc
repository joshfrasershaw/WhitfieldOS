{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "whitfieldos",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-23",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api", "/api/*"],
    "not_found_handling": "single-page-application",
  },
}
